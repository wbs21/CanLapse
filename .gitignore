# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# ---- 环境变量与本地密钥 ----
.env
.env.*
!.env.example
*.local

# ---- 日志与临时文件 ----
*.log
logs/
tmp/
temp/
*.tmp

# ---- Rust ----
# 注意：Cargo.lock 对二进制 crate 应当提交，不要忽略它。
target/
**/target/

# ---- 构建产物（通用）----
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
coverage/
.cache/

# ---- 原型产出的截图是验证证据，需要提交，因此不忽略 spikes/**/out/ ----

# ---- 技术验证原型的临时抓取/编译产物（证据截图要提交，这些不要）----
spikes/*/_probe/
*.obj

# ---- 本地测试产物 ----
.test-cache/

# ---- 端到端测试产物 ----
.e2e-cache/

# ---- 他人的 UI 草稿暂存区（文件保留在磁盘，不进版本库）----
add/

# ---- SAI2 实测产物 ----
.sai-test/

# ---- GUI 端到端产物 ----
.gui-e2e/
.gui-*.png
.gui-pid
.gui-out.txt
.gui-err.txt

# ---- 临时诊断输出（跑验证脚本时产生）----
.*-err.txt
.*-out.txt
