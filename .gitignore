# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# ---- 环境变量与本地密钥 ----
.env
.env.*
!.env.example
*.local

# ---- 日志与临时文件 ----
*.log
logs/
tmp/
temp/
*.tmp

# ---- Rust ----
# 注意：Cargo.lock 对二进制 crate 应当提交，不要忽略它。
target/
**/target/

# ---- 构建产物（通用）----
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
coverage/
.cache/

# ---- 原型产出的截图是验证证据，需要提交，因此不忽略 spikes/**/out/ ----

# ---- 技术验证原型的临时抓取/编译产物（证据截图要提交，这些不要）----
spikes/*/_probe/
*.obj

# ---- 本地测试产物 ----
.test-cache/

# ---- 端到端测试产物 ----
.e2e-cache/

# ---- 他人的 UI 草稿暂存区（文件保留在磁盘，不进版本库）----
add/

# ---- SAI2 实测产物 ----
.sai-test/

# ---- GUI 端到端产物 ----
.gui-e2e/
.gui-*.png
.gui-pid
.gui-out.txt
.gui-err.txt

# ---- 临时诊断输出（跑验证脚本时产生）----
.*-err.txt
.*-out.txt

# ---- 验证脚本用的临时缓存目录（都是点开头，别再提交）----
.mf2/
.multiframe/
.real2/
.real-timelapse/
.mark-check/
.krita-real/
.hist-check/
.hist-check2/
.fg-check/
.fg-check2/
.bar-check/
.warn-check/
.warn-gui/
.shot/

# ---- 测试缓存统一入口 ----
# 约定：所有验证脚本的 --out 一律指向 .testcache\<名字>，这样只需一条规则。
# （此前每轮临时起一个点开头目录名，忘了加规则就会被 git add -A 扫进提交 —— 踩过两次）
.testcache/
.rz/
